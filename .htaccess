# ceng.az - static/PHP build (served from )
Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

# Deny access to version-control metadata if present
RedirectMatch 404 /\.git

# IMPORTANT: having RewriteEngine On in this subfolder stops Apache from
# inheriting the parent WordPress .htaccess rewrite rules, which otherwise
# catch every /* request and return WordPress's 404 page.
# Existing files and directories (assets, page folders) are served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Projects created in the admin panel (no static folder): /my-project/ -> project-view.php
  RewriteRule ^([a-z0-9-]+)/?$ project-view.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>
